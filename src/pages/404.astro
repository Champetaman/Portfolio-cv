---
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import ChevronLeftIcon from "@/icons/common/ChevronLeft.astro";
import MailIcon from "@/icons/common/Mail.astro";
---

<ErrorLayout title="Page not found — Camilo Oviedo" description="The requested page could not be found.">
  <main id="main-content" class="shell grid min-h-[calc(100vh-16rem)] content-center py-16">
    <div class="error-record">
      <p class="error-code" aria-hidden="true">404</p>
      <div>
        <h1 class="section-title">Page not found.</h1>
        <p class="section-intro">This address does not match a page on this website. Check the URL or return to the homepage.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="primary-action" href="/"><ChevronLeftIcon class="size-5" /> Portfolio home</a>
          <a class="secondary-action" href="mailto:oviedocamilo94@gmail.com"><MailIcon class="size-5" /> Email Camilo</a>
        </div>
      </div>
    </div>
  </main>
</ErrorLayout>
