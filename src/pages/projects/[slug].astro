---
import Layout from "@/layouts/Layout.astro";
import Technologies from "@/components/technologies/Technologies.astro";
import ChevronLeftIcon from "@/icons/common/ChevronLeft.astro";
import WWWIcon from "@/icons/common/WWW.astro";
import GithubRepoIcon from "@/icons/social/GithubRepo.astro";
import projectsData from "@/../data/projects.json";

interface Technology {
  name: string;
  icon?: string;
}

interface ProjectRecord {
  title: string;
  summary?: string;
  description: string;
  contribution?: string;
  highlights?: string[];
  date?: string;
  visibility?: string;
  link?: string;
  github?: string;
  image: string;
  imagehd?: string;
  altImage: string;
  slug: string;
  technologies: Technology[];
}

interface ProjectGroup {
  personal?: ProjectRecord[];
  contribution?: ProjectRecord[];
  professional?: ProjectRecord[];
}

const { slug } = Astro.params;
const allProjects = (projectsData as ProjectGroup[]).flatMap((category) => [
  ...(category.personal ?? []),
  ...(category.contribution ?? []),
  ...(category.professional ?? []),
]);
const project = allProjects.find((item) => item.slug === slug);

if (!project) {
  return Astro.rewrite("/404");
}
---

<Layout title={`${project.title} — Camilo Oviedo`} description={project.summary ?? project.description} image={project.image}>
  <main id="main-content" class="shell">
    <header class="project-detail-hero">
      <a class="inline-link gap-2" href="/#projects"><ChevronLeftIcon class="size-5" /> Back to projects</a>
      <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
        <div>
          <h1 class="max-w-[18ch] text-[clamp(2.8rem,7vw,5.7rem)] font-[560] leading-[0.96] tracking-[-0.04em] text-balance">{project.title}</h1>
          <p class="mt-7 max-w-[68ch] text-lg leading-relaxed text-[var(--muted)] sm:text-xl">{project.summary ?? project.description}</p>
        </div>
        {(project.date || project.visibility) && (
          <dl class="border-y border-[var(--rule)]">
            {project.date && <div class="py-4"><dt class="meta-label">Timeline</dt><dd class="mt-2">{project.date}</dd></div>}
            {project.visibility && <div class="border-t border-[var(--rule)] py-4"><dt class="meta-label">Access</dt><dd class="mt-2 text-sm text-[var(--muted)]">{project.visibility}</dd></div>}
          </dl>
        )}
      </div>
    </header>

    <section class="py-[clamp(3rem,7vw,7rem)]" aria-labelledby="artifact-title">
      <h2 id="artifact-title" class="section-title">Project interface.</h2>
      <figure class="project-detail-exhibit">
        <img src={project.image} alt={project.altImage} loading="eager" decoding="async" />
        <figcaption>{project.title} · Interface view supplied for this portfolio</figcaption>
      </figure>
      {project.imagehd && project.imagehd !== project.image && <a class="inline-link mt-4" href={project.imagehd} target="_blank" rel="noopener noreferrer">Open full-resolution image</a>}
    </section>

    <section class="grid gap-10 border-t border-[var(--rule)] py-[clamp(3rem,7vw,7rem)] lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.8fr)] lg:gap-20" aria-labelledby="context-title">
      <div>
        <h2 id="context-title" class="section-title">Context and contribution.</h2>
        <p class="mt-8 max-w-[68ch] text-lg leading-relaxed text-[var(--muted)]">{project.description}</p>
        {project.contribution && <p class="mt-6 max-w-[68ch] text-lg leading-relaxed">{project.contribution}</p>}
        {project.highlights && (
          <ul class="mt-8 rule-list border-y border-[var(--rule)]">
            {project.highlights.map((highlight) => <li class="py-4">{highlight}</li>)}
          </ul>
        )}
        <div class="mt-8 flex flex-wrap gap-3">
          {project.link && <a class="primary-action" href={project.link} target="_blank" rel="noopener noreferrer"><WWWIcon class="size-5" /> Visit website</a>}
          {project.github && <a class="secondary-action" href={project.github} target="_blank" rel="noopener noreferrer"><GithubRepoIcon class="size-5" /> View source</a>}
        </div>
      </div>
      <aside aria-labelledby="technology-title">
        <h2 id="technology-title" class="text-2xl font-medium tracking-[-0.025em]">Technology context</h2>
        <p class="mt-3 text-[var(--muted)]">Recorded tools and platforms used within this project.</p>
        <div class="mt-7"><Technologies technologies={project.technologies} /></div>
      </aside>
    </section>
  </main>
</Layout>
