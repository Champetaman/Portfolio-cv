---
const capabilities = [
  {
    title: "Business and systems analysis",
    copy: "Requirements gathering, process analysis, stakeholder alignment, use cases, activity diagrams, data flows, sequence diagrams and entity relationships.",
  },
  {
    title: "Applications and automation",
    copy: "API integrations, workflow automation, operational systems administration, inventory controls, payment reconciliation and reporting.",
  },
  {
    title: "Technical delivery",
    copy: "Java, JavaScript, TypeScript, Angular, React, SQL, REST services, automated testing, CI/CD, Docker and AWS delivery contexts.",
  },
  {
    title: "Financial-domain systems",
    copy: "Securities, pensions, valuation, fintech, accounting, regulatory alignment and high-availability operational support.",
  },
];
---

<section id="capabilities" class="shell section-grid" aria-labelledby="capabilities-title">
  <div class="section-folio" aria-hidden="true">
    <strong>03</strong>
    <span>Capabilities</span>
  </div>
  <div class="section-body">
    <h2 id="capabilities-title" class="section-title">How I work across analysis and delivery.</h2>
    <p class="section-intro">Tools matter in context. These groups describe where I contribute across analysis, implementation and operations.</p>

    <div class="mt-12 grid border-y border-[var(--rule)] md:grid-cols-2">
      {capabilities.map((capability, index) => (
        <article class:list={["py-7", index % 2 === 0 ? "md:border-r md:pr-8" : "md:pl-8", index > 1 ? "border-t border-[var(--rule)]" : "", index === 1 ? "border-t border-[var(--rule)] md:border-t-0" : ""]}>
          <h3 class="text-2xl font-medium tracking-[-0.025em]">{capability.title}</h3>
          <p class="mt-4 max-w-[58ch] text-[var(--muted)]">{capability.copy}</p>
        </article>
      ))}
    </div>

  </div>
</section>
