---
import projectsData from "@/../data/projects.json";
import Technologies from "@/components/technologies/Technologies.astro";
import ChevronRightIcon from "@/icons/common/ChevronRight.astro";
import WWWIcon from "@/icons/common/WWW.astro";
import GithubRepoIcon from "@/icons/social/GithubRepo.astro";

interface Technology {
  name: string;
  icon?: string;
}

interface ProjectRecord {
  title: string;
  summary?: string;
  description: string;
  contribution?: string;
  date?: string;
  visibility?: string;
  link?: string;
  github?: string;
  image: string;
  altImage: string;
  slug: string;
  technologies: Technology[];
}

interface ProjectGroup {
  personal?: ProjectRecord[];
  contribution?: ProjectRecord[];
  professional?: ProjectRecord[];
}

const source = projectsData as ProjectGroup[];
const projectGroups = [
  {
    title: "Personal projects",
    description: "Independent products used to explore practical applications of modern web and AI technologies.",
    projects: source.flatMap((group) => group.personal ?? []),
  },
  {
    title: "Open-source contributions",
    description: "Public collaboration that demonstrates contribution within an established product and engineering community.",
    projects: source.flatMap((group) => group.contribution ?? []),
  },
  {
    title: "Professional projects",
    description: "Systems delivered across operations, forecasting, financial services, process transformation and digital experience.",
    projects: source.flatMap((group) => group.professional ?? []),
  },
];
const totalProjects = projectGroups.reduce((total, group) => total + group.projects.length, 0);
---

<section id="projects" class="shell section-grid" aria-labelledby="projects-title">
  <div class="section-folio" aria-hidden="true">
    <strong>02</strong>
    <span>Projects</span>
  </div>
  <div class="section-body">
    <header class="project-section-header">
      <div>
        <h2 id="projects-title" class="section-title">Projects and contributions.</h2>
        <p class="section-intro">Personal, open-source and professional work—presented as a complete portfolio rather than a selected shortlist.</p>
      </div>
      <p class="project-count" aria-label={`${totalProjects} projects in this portfolio`}><strong>{String(totalProjects).padStart(2, "0")}</strong><span>projects</span></p>
    </header>

    <div class="mt-16 space-y-16 lg:space-y-20">
      {projectGroups.map((group) => (
      <section aria-labelledby={`${group.title.toLowerCase().replaceAll(" ", "-")}-title`}>
        <header class="project-group-header">
          <div>
            <h3 id={`${group.title.toLowerCase().replaceAll(" ", "-")}-title`} class="text-2xl font-medium tracking-[-0.025em] sm:text-3xl">{group.title}</h3>
            <p class="mt-3 max-w-[66ch] text-[var(--muted)]">{group.description}</p>
          </div>
          <span class="font-mono text-xs uppercase tracking-[0.06em] text-[var(--muted)]">{String(group.projects.length).padStart(2, "0")} projects</span>
        </header>

        <div class="project-register">
          {group.projects.map((project) => (
            <article id={project.slug} class="project-record">
              <div class="project-record-layout">
                <figure class="project-exhibit">
                  <a href={`/projects/${project.slug}`} aria-label={`Open details for ${project.title}`}>
                    <img src={project.image} alt={project.altImage} loading="lazy" decoding="async" width="1200" height="900" />
                  </a>
                  <figcaption>{project.title} · Project interface</figcaption>
                </figure>

                <div class="project-snippet">
                  <header>
                    <p class="meta-label">{group.title}</p>
                    <h4 class="mt-3 text-[clamp(1.8rem,3vw,2.8rem)] font-[560] leading-[1] tracking-[-0.035em] text-balance">{project.title}</h4>
                    {(project.date || project.visibility) && (
                      <div class="project-record-meta mt-4">
                        {project.date && <time>{project.date}</time>}
                        {project.visibility && <span>{project.visibility}</span>}
                      </div>
                    )}
                  </header>
                  <div class="project-summary mt-6">
                    <p class="text-lg leading-relaxed">{project.summary ?? project.description}</p>
                    {project.contribution && <p class="mt-4 text-[var(--muted)]">{project.contribution}</p>}
                  </div>
                  <div class="mt-7">
                    <p class="meta-label mb-4">Technology context</p>
                    <Technologies technologies={project.technologies} limit={6} compact />
                  </div>
                  <div class="project-actions">
                    <a class="primary-action" href={`/projects/${project.slug}`}>Project details <ChevronRightIcon class="size-5" /></a>
                    {project.link && <a class="secondary-action" href={project.link} target="_blank" rel="noopener noreferrer"><WWWIcon class="size-5" /> Visit website</a>}
                    {project.github && <a class="secondary-action" href={project.github} target="_blank" rel="noopener noreferrer"><GithubRepoIcon class="size-5" /> Source code</a>}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
      ))}
    </div>
  </div>
</section>
