---
import casualImage from "@/img/casual_image.webp";
import OpenAIIcon from "@/icons/ai/OpenAI.astro";
import SettingsCodeIcon from "@/icons/common/SettingsCode.astro";
import CodeIcon from "@/icons/common/Code.astro";

const currentPractices = [
  {
    title: "AI-assisted analysis and delivery",
    Icon: OpenAIIcon,
  },
  {
    title: "Modern application architecture",
    Icon: SettingsCodeIcon,
  },
  {
    title: "Automated testing and review",
    Icon: CodeIcon,
  },
];
---

<section id="about" class="shell section-grid" aria-labelledby="about-title">
  <div class="section-folio" aria-hidden="true">
    <strong>04</strong>
    <span>About</span>
  </div>
  <div class="section-body">
    <h2 id="about-title" class="section-title">
      Modern engineering, grounded in business outcomes.
    </h2>
    <div class="about-layout">
      <figure class="about-portrait">
        <div class="about-portrait-frame">
          <img
            src={casualImage.src}
            width={casualImage.width}
            height={casualImage.height}
            alt="Camilo Oviedo seated outdoors"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>Beyond the systems</figcaption>
      </figure>
      <div class="about-copy">
        <div class="max-w-[65ch] space-y-5 text-lg text-[var(--muted)]">
          <p>
            My combined business and technical perspective shapes how I approach
            change: understand the operating reality, make the technical
            implications clear, and keep stakeholders aligned.
          </p>
          <p>
            I keep my engineering practice current across AI-assisted delivery,
            modern application architecture, automated quality and coordinated
            development tools. I adopt new methods where they sharpen analysis,
            accelerate delivery and make software more reliable not for novelty.
          </p>
        </div>
        <ul
          class="about-practice-list"
          aria-label="Current engineering practices"
        >
          {
            currentPractices.map(({ title, Icon }) => (
              <li>
                <span class="about-practice-icon" aria-hidden="true">
                  <Icon class="size-5" />
                </span>
                <span>{title}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
