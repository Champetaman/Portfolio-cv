---
import GitHubIcon from "@/icons/social/GitHub.astro";
import LinkedInIcon from "@/icons/social/LinkedIn.astro";
import MailIcon from "@/icons/common/Mail.astro";
import DownloadIcon from "@/icons/common/Download.astro";

const currentYear = new Date().getFullYear();
const ResumePDF = import.meta.env.RESUME_PDF_URL;
---

<footer class="mt-6 border-t border-[var(--rule)]">
  <div class="shell grid gap-5 py-6 text-sm md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="font-semibold">Camilo Oviedo</p>
      <p class="mt-1 max-w-xl text-[var(--muted)]">Technical Business Analyst · Business Systems Analyst · Application Analyst</p>
      <p class="mt-4 font-mono text-xs text-[var(--muted)]">© {currentYear} · Melbourne, Australia</p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-4 gap-y-2">
      <a class="inline-link gap-2" href="mailto:oviedocamilo94@gmail.com"><MailIcon class="size-4" /> Email</a>
      <a class="inline-link gap-2" href="https://www.linkedin.com/in/oviedocamilo/" target="_blank" rel="noopener noreferrer"><LinkedInIcon class="size-4" /> LinkedIn</a>
      <a class="inline-link gap-2" href="https://github.com/Champetaman" target="_blank" rel="noopener noreferrer"><GitHubIcon class="size-4" /> GitHub</a>
      {ResumePDF && <a class="inline-link gap-2" href={ResumePDF} target="_blank" rel="noopener noreferrer"><DownloadIcon class="size-4" /> Résumé (PDF)</a>}
    </nav>
    <div class="border-t border-[var(--rule)] pt-4 md:col-span-2">
      <p class="max-w-[68ch] text-[var(--muted)]"><a class="text-[var(--accent)] underline underline-offset-4" href="/career-ops">Career Ops</a> is Camilo's personal AI-assisted job-search workflow. It reads Gmail job alerts, helps assess opportunities and prepares application materials for review.</p>
      <nav aria-label="Career Ops information" class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
        <a class="inline-link" href="/career-ops">About Career Ops</a>
        <a class="inline-link" href="/career-ops/privacy">Privacy Policy</a>
        <a class="inline-link" href="/career-ops/terms-of-service">Terms of Service</a>
      </nav>
    </div>
  </div>
</footer>
