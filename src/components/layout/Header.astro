---
import navItems from "@/../data/navItems.json";
import HamburguerIcon from "@/icons/common/Hamburguer.astro";
import LightModeIcon from "@/icons/Theme/LightMode.astro";
import DarkModeIcon from "@/icons/Theme/DarkMode.astro";
import GitHubIcon from "@/icons/social/GitHub.astro";
import LinkedInIcon from "@/icons/social/LinkedIn.astro";

const navHref = (url: string) =>
  Astro.url.pathname === "/" && url.startsWith("/#") ? url.slice(1) : url;
---

<header class="sticky top-0 z-40 border-b border-[var(--rule)] bg-[var(--canvas)]">
  <div class="shell flex min-h-16 items-center justify-between gap-5">
    <a href="/" class="flex min-h-11 items-center gap-3 no-underline" aria-label="Camilo Oviedo, home">
      <span class="font-semibold tracking-[-0.025em]">Camilo Oviedo</span>
      <span class="hidden font-mono text-[0.7rem] uppercase tracking-[0.06em] text-[var(--muted)] md:inline">Systems Engineering &amp; Business Administration</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-4 xl:flex">
      {navItems.map((item) => (
        <a class="inline-flex min-h-11 items-center text-sm text-[var(--muted)] hover:text-[var(--ink)]" href={navHref(item.url)}>
          {item.title}
        </a>
      ))}
      <span class="h-5 w-px bg-[var(--rule)]" aria-hidden="true"></span>
      <a class="social-icon-link" href="https://www.linkedin.com/in/oviedocamilo/" target="_blank" rel="noopener noreferrer" aria-label="Camilo Oviedo on LinkedIn"><LinkedInIcon class="size-5" /></a>
      <a class="social-icon-link" href="https://github.com/Champetaman" target="_blank" rel="noopener noreferrer" aria-label="Camilo Oviedo on GitHub"><GitHubIcon class="size-5" /></a>
      <button class="theme-toggle grid size-11 place-items-center text-[var(--muted)] hover:text-[var(--ink)]" type="button" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">
        <LightModeIcon class="size-5" data-theme-icon="light" />
        <DarkModeIcon class="hidden size-5" data-theme-icon="dark" />
      </button>
    </nav>

    <div class="flex items-center gap-1 xl:hidden">
      <button class="theme-toggle grid size-11 place-items-center text-[var(--muted)]" type="button" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">
        <LightModeIcon class="size-5" data-theme-icon="light" />
        <DarkModeIcon class="hidden size-5" data-theme-icon="dark" />
      </button>
      <details data-mobile-menu class="relative">
        <summary class="grid size-11 cursor-pointer list-none place-items-center text-[var(--muted)]" aria-label="Open navigation">
          <HamburguerIcon class="size-6" />
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 top-13 w-[min(19rem,calc(100vw-2rem))] border border-[var(--rule)] bg-[var(--paper)] p-2 shadow-[0_18px_45px_rgba(0,0,0,0.14)]">
          {navItems.map((item, index) => (
            <a class="flex min-h-12 items-center justify-between border-b border-[var(--rule)] px-3 text-base last:border-b-0" href={navHref(item.url)}>
              <span>{item.title}</span>
              <span class="font-mono text-xs text-[var(--muted)]" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
