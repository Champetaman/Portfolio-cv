---
import heroImage from "@/img/profile_image.webp";
import DownloadIcon from "@/icons/common/Download.astro";
import ChevronRightIcon from "@/icons/common/ChevronRight.astro";
import BriefcaseIcon from "@/icons/common/Briefcase.astro";
import MailIcon from "@/icons/common/Mail.astro";

const ResumePDF = import.meta.env.RESUME_PDF_URL;
---

<section
  class="shell grid border-b border-[var(--rule)] lg:grid-cols-[6.5rem_minmax(0,1fr)]"
>
  <aside
    class="hidden border-r border-[var(--rule)] pt-7 pr-4 font-mono text-[0.68rem] uppercase tracking-[0.08em] text-[var(--muted)] lg:block"
    aria-label="Profile metadata"
  >
    <p class="text-[var(--accent)]">Profile</p>
    <p class="mt-7">Technical<br />business<br />analysis</p>
    <p class="mt-7">Melbourne<br />Australia</p>
  </aside>

  <div class="py-8 lg:pl-[clamp(2rem,3vw,3rem)] lg:pt-10">
    <div
      class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-8"
    >
      <div class="document-enter">
        <p
          class="max-w-2xl text-sm font-medium text-[var(--accent)]"
        >
          Technical Business Analyst · Business Systems Analyst · Application
          Analyst
        </p>
        <h1
          class="hero-title mt-4"
        >
          I turn complex operations into clear requirements, reliable
          applications and better ways of working.
        </h1>
        <p
          class="lead-copy mt-4 max-w-[62ch] text-[var(--muted)]"
        >
          I connect business needs, stakeholder context and technical delivery
          across financial systems, workflow automation and application
          modernisation.
        </p>
        <div
          class="availability-signal"
          role="note"
          aria-label="Employment availability"
        >
          <span class="availability-icon"><BriefcaseIcon class="size-5" /></span
          >
          <span>Open to analyst and application-focused opportunities.</span>
        </div>
        <div
          class="mt-5 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center"
        >
          <a class="primary-action" href="mailto:oviedocamilo94@gmail.com">
            <MailIcon class="size-5" />
            Email Camilo
          </a>
          {
            ResumePDF && (
              <a
                class="secondary-action"
                href={ResumePDF}
                target="_blank"
                rel="noopener noreferrer"
              >
                Download résumé
                <DownloadIcon class="size-5" />
              </a>
            )
          }
          <a class="inline-link px-1 text-sm" href="#projects">
            View projects
            <ChevronRightIcon class="size-5" />
          </a>
        </div>
      </div>

      <figure
        class="document-enter document-enter-delay w-full max-w-[13rem] sm:max-w-[15rem] lg:max-w-[16rem] lg:justify-self-end lg:pt-6"
      >
        <div class="relative border border-[var(--rule)] bg-[var(--paper)] p-2">
          <img
            src={heroImage.src}
            width={heroImage.width}
            height={heroImage.height}
            alt="Portrait of Camilo Oviedo"
            loading="eager"
            decoding="async"
            class="aspect-[4/5] w-full object-cover object-top grayscale-[12%]"
          />
          <span
            class="absolute -top-px -left-px size-3 border-t border-l border-[var(--accent)]"
            aria-hidden="true"></span>
          <span
            class="absolute -right-px -bottom-px size-3 border-r border-b border-[var(--accent)]"
            aria-hidden="true"></span>
        </div>
        <figcaption
          class="mt-3 flex justify-between gap-4 font-mono text-[0.68rem] uppercase tracking-[0.06em] text-[var(--muted)]"
        >
          <span>Camilo Oviedo</span>
          <span>Melbourne</span>
        </figcaption>
      </figure>
    </div>

    <section
      class="mt-8 border-t border-[var(--rule)] pt-5"
      aria-labelledby="achievement-title"
    >
      <h2 id="achievement-title" class="subheading">
        Selected career achievements
      </h2>
      <dl class="mt-4 grid border-y border-[var(--rule)] md:grid-cols-3">
        <div
          class="border-b border-[var(--rule)] py-4 md:border-r md:border-b-0 md:pr-5"
        >
          <dt class="meta-label">Operations automation</dt>
          <dd class="mt-2 font-medium">
            Order processing reduced from ~40 minutes to ~2 minutes.
          </dd>
        </div>
        <div
          class="border-b border-[var(--rule)] py-4 md:border-r md:border-b-0 md:px-5"
        >
          <dt class="meta-label">Systems modernisation</dt>
          <dd class="mt-2 font-medium">
            30% operational-efficiency and 25% reliability improvements
            recorded.
          </dd>
        </div>
        <div class="py-4 md:pl-5">
          <dt class="meta-label">Technical continuity</dt>
          <dd class="mt-2 font-medium">
            35% reduction in system downtime recorded at the Central Bank.
          </dd>
        </div>
      </dl>
    </section>
  </div>
</section>
