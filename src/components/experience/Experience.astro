---
import ExperienceData from "@/../data/experience.json";

interface Position {
  date: string;
  title: string;
  achievements: string[];
}

interface CompanyExperience {
  company: string;
  location: string;
  positions: Position | Position[];
}

const EXPERIENCE = ExperienceData as CompanyExperience[];
const positionsFor = (entry: CompanyExperience) => Array.isArray(entry.positions) ? entry.positions : [entry.positions];
---

<section id="experience" class="shell section-grid" aria-labelledby="experience-title">
  <div class="section-folio" aria-hidden="true">
    <strong>01</strong>
    <span>Experience</span>
  </div>
  <div class="section-body">
    <h2 id="experience-title" class="section-title">Experience across systems and operations.</h2>
    <p class="section-intro">8+ years connecting operational needs with reliable software delivery across Australia and Colombia.</p>

    <ol class="section-content border-y border-[var(--rule)]">
      {EXPERIENCE.map((entry) => (
        <li class="grid gap-5 border-b border-[var(--rule)] py-6 last:border-b-0 lg:grid-cols-[13rem_minmax(0,1fr)]">
          <div>
            <h3 class="subheading">{entry.company}</h3>
            <p class="mt-2 font-mono text-xs uppercase tracking-[0.05em] text-[var(--muted)]">{entry.location}</p>
          </div>
          <div class="rule-list">
            {positionsFor(entry).map((position) => (
              <article class="grid gap-4 py-1 first:pt-0 not-first:mt-5 not-first:pt-5 md:grid-cols-[minmax(10rem,0.65fr)_minmax(0,1.35fr)]">
                <div>
                  <h4 class="font-medium">{position.title}</h4>
                  <time class="mt-2 block font-mono text-xs text-[var(--muted)]">{position.date.trim().replace(" - ", " – ")}</time>
                </div>
                <ul class="space-y-2 text-[var(--muted)]">
                  {position.achievements.map((achievement) => <li>{achievement}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
