---
import TechnologyIcon from "@/components/technologies/TechnologyIcon.astro";

interface Technology {
  name: string;
  icon?: string;
}

interface Props {
  technologies?: Technology[];
  limit?: number;
  compact?: boolean;
}

const { technologies = [], limit, compact = false } = Astro.props;
const visibleTechnologies = typeof limit === "number" ? technologies.slice(0, limit) : technologies;
const remaining = technologies.length - visibleTechnologies.length;
---

<ul class:list={["technology-list", compact && "technology-list--compact"]} aria-label="Technologies used">
  {visibleTechnologies.map((technology) => (
    <li>
      <span class="technology-icon"><TechnologyIcon icon={technology.icon} class="size-5" /></span>
      <span>{technology.name}</span>
    </li>
  ))}
  {remaining > 0 && <li class="technology-more">+{remaining} more technologies</li>}
</ul>
